  "dialogues": {
    "toby": {
      "name": "Toby",
      "intro": [
        [
          "Toby",
          "FBI mısınız? Ben hiçbir şey yapmadım."
        ],
        [
          "Maya",
          "FCD. Ve henüz kimse bir şey demedi."
        ],
        [
          "Oscar",
          "Sakız çiğneme hızından anladığım kadarıyla, bir şey yapmışsın. Ama belki yakutu çalmak değil."
        ]
      ],
      "claim": "Galanın sonunu hatırlamıyorum, tamam mı?",
      "topics": [
        {
          "q": "Gala sırasında neredeydin?",
          "lines": [
            [
              "Toby",
              "Buralarda. Herkes gibi. Kalabalıktı."
            ],
            [
              "Oscar",
              "'Buralarda'. Klasik yalancı adresi."
            ]
          ]
        },
        {
          "q": "Amcan Harold nasıl biridir?",
          "lines": [
            [
              "Toby",
              "Müzeyi benden çok seviyor. Son zamanlarda çok gergin ama. Hep telefonda."
            ]
          ]
        }
      ],
      "show": {
        "sakiz": {
          "lines": [
            [
              "Toby",
              "Herkes sakız çiğner!"
            ],
            [
              "Oscar",
              "Ama herkes galanın ortasında hole kaçıp kağıdı yere atmaz."
            ],
            [
              "Toby",
              "Ben... biraz hava almaya çıktım. O kadar."
            ]
          ]
        }
      }
    },
    "vivian": {
      "name": "Vivian Lark",
      "intro": [
        [
          "Vivian",
          "Oscar Penn. Kartlarını kaybeden sihirbaz. Gazetede okumuştum."
        ],
        [
          "Oscar",
          "Kartlarımı değil, seyircimi kaybettim. Farklı şey."
        ],
        [
          "Vivian",
          "Ben mücevher eksperiyim. Yakutu galadan önce görmem gerekiyordu. Harold izin vermedi."
        ]
      ],
      "claim": "21:30'da çıktım. Sıkıcı bir partiydi.",
      "topics": [
        {
          "q": "Ellerine ve dizine bak (soğuk okuma)",
          "lines": [
            [
              "Oscar",
              "Avucunuzda toz, dizinizde iz. Yere eğildiniz. Bu salonda yere eğilecek tek ilginç yer vitrinin dibi."
            ],
            [
              "Vivian",
              "Etkileyici. Ama hiçbir şey kanıtlamaz."
            ]
          ]
        },
        {
          "q": "Harold yakutu neden göstermedi?",
          "lines": [
            [
              "Vivian",
              "Bana sorarsan bir şey saklıyordu. Ama bana kimse sormaz."
            ]
          ]
        }
      ],
      "show": {
        "ruj": {
          "lines": [
            [
              "Vivian",
              "Peki. Belki biraz daha kaldım. Şampanya bedavaydı."
            ]
          ]
        },
        "misafir": {
          "lines": [
            [
              "Vivian",
              "Listeyi tutan çocuk Toby'ydi. Yarısını boş bıraktı."
            ],
            [
              "Oscar",
              "Ama sadece sizinkini boş bıraktı."
            ]
          ]
